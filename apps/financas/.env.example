# Chave mestra local (NUNCA compartilhar nem enviar à Railway)
# Se omitida, o Edge gera automaticamente em ./local-config/master.key
FINANCAS_MASTER_KEY=troque-por-uma-chave-com-32-caracteres-ou-mais

# URL pública do backend opaco na Railway (vazio = usa SQLite local)
FINANCAS_BACKEND_URL=https://seu-backend.up.railway.app

# Token Bearer compartilhado entre Edge Local e Backend Opaco
FINANCAS_SYNC_TOKEN=troque-por-um-token-aleatorio

# Fallback opcional de IA (também configurável na tela Configurações da UI)
GEMINI_API_KEY=

# Domínio do Traefik no lab.projects (ex: traefik.me hoje, lab.lan no futuro homelab)
LAB_DOMAIN=traefik.me
